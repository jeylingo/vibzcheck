rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(roomId) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }

    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function queueUnlocked(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.queueLocked != true;
    }

    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if false;
      }
    }

    match /listeningHistory/{historyId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (resource.data.isPrivate == false || isMember(roomId) || isOwner(roomId));
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(roomId);

      match /members/{uid} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create: if signedIn() && uid == request.auth.uid;
        allow update: if signedIn() && uid == request.auth.uid;
        allow delete: if isOwner(roomId) || uid == request.auth.uid;
      }

      match /queue/{songId} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create: if (isMember(roomId) || isOwner(roomId)) && (queueUnlocked(roomId) || isOwner(roomId));
        allow update, delete: if isOwner(roomId);

        match /votes/{uid} {
          allow read: if isMember(roomId) || isOwner(roomId);
          allow create, update, delete: if signedIn() && uid == request.auth.uid && (isMember(roomId) || isOwner(roomId));
        }
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create: if isMember(roomId) || isOwner(roomId);
        allow update, delete: if false;

        match /reactions/{uid} {
          allow read: if isMember(roomId) || isOwner(roomId);
          allow create, update, delete: if signedIn() && uid == request.auth.uid && (isMember(roomId) || isOwner(roomId));
        }
      }

      match /typingStatus/{uid} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create, update: if signedIn() && uid == request.auth.uid && (isMember(roomId) || isOwner(roomId));
        allow delete: if signedIn() && uid == request.auth.uid;
      }

      match /history/{historyId} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create: if isOwner(roomId);
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create: if isMember(roomId) || isOwner(roomId);
        allow update, delete: if false;
      }
    }

    match /playlists/{playlistId} {
      function playlistDoc() {
        return get(/databases/$(database)/documents/playlists/$(playlistId));
      }

      function isPlaylistOwner() {
        return signedIn() && playlistDoc().data.ownerId == request.auth.uid;
      }

      function canReadPlaylist() {
        return signedIn() && (playlistDoc().data.ownerId == request.auth.uid || request.auth.uid in playlistDoc().data.members);
      }

      allow read: if canReadPlaylist();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isPlaylistOwner();

      match /songs/{songId} {
        allow read: if canReadPlaylist();
        allow create: if signedIn() && (playlistDoc().data.ownerId == request.auth.uid || request.auth.uid in playlistDoc().data.members);
        allow update, delete: if signedIn() && playlistDoc().data.ownerId == request.auth.uid;

        match /votes/{uid} {
          allow read: if canReadPlaylist();
          allow create, update, delete: if signedIn() && uid == request.auth.uid && canReadPlaylist();
        }
      }
    }
  }
}
